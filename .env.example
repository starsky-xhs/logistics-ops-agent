# 默认离线运行：不需要 API Key，不会访问网络
PLANNER=mock
DB_PATH=data/logistics.db

# 状态机预算
MAX_STEPS=8
TIME_BUDGET_SECONDS=20

# high_only：高风险必审批；conservative：中风险也审批
APPROVAL_POLICY=high_only
AUDIT_MASK_PII=true

# 只有 PLANNER=llm 时才读取这些配置
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=15
